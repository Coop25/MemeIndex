MEMEINDEX_ADDR=:8080
MEMEINDEX_DATA_DIR=data
# Optional private diagnostics listener: Prometheus /metrics + /debug/pprof/.
# Leave blank to disable. Bind to loopback or a private interface only.
MEMEINDEX_DEBUG_ADDR=
MEMEINDEX_MEDIAFETCH_YTDLP_BINARY=yt-dlp
# Downloader egress isolation. Set to a forward proxy that only allows the public
# media hosts (see docker-compose.yml and the README). yt-dlp and the media
# fetch HTTP client both route through it. Leave blank to instead pin outbound
# downloader connections to public IP addresses only.
MEMEINDEX_MEDIAFETCH_PROXY=
# Hosts that must bypass the proxy above (internal services). Only used when a
# proxy is set.
MEMEINDEX_NO_PROXY=postgres,ollama,localhost,127.0.0.1,::1
MEMEINDEX_MEDIAFETCH_RETRY_INTERVAL_SECONDS=300
MEMEINDEX_MEDIAFETCH_RETRY_MAX_ATTEMPTS=3

# Per-identity request rate limiting on auth, upload, link-import, and share
# endpoints. Leave enabled unless a trusted bulk import needs the ceiling lifted.
MEMEINDEX_RATE_LIMIT_ENABLED=true
# Header your reverse proxy sets with the real client IP (e.g. CF-Connecting-IP).
# Leave blank when clients connect to the origin directly; a forwarding header is
# only trusted when named here.
MEMEINDEX_CLIENT_IP_HEADER=
MEMEINDEX_IMAGE=ghcr.io/your-github-user-or-org/memeindex:latest
MEMEINDEX_TAGSUGGEST_OLLAMA_URL=http://ollama:11434
MEMEINDEX_TAGSUGGEST_OLLAMA_MODEL=qwen2.5vl:3b
MEMEINDEX_TAGSUGGEST_TIMEOUT_SECONDS=300
MEMEINDEX_TAGSUGGEST_MAX_TAGS=8
MEMEINDEX_TAGSUGGEST_KNOWN_TAG_BUDGET=60
MEMEINDEX_TAGSUGGEST_FAST_MODE=false
MEMEINDEX_TAGSUGGEST_GENERATE_ONLY=false
MEMEINDEX_TAGSUGGEST_VIDEO_FRAME_COUNT=
MEMEINDEX_TAGSUGGEST_VIDEO_FRAME_WIDTH=
MEMEINDEX_TAGSUGGEST_DISABLE_TRANSCRIPTION=false
MEMEINDEX_TAGSUGGEST_TRANSCRIBE_BINARY=
MEMEINDEX_TAGSUGGEST_TRANSCRIBE_ARGS=
MEMEINDEX_TAGSUGGEST_TRANSCRIBE_TIMEOUT_SECONDS=120
OLLAMA_KEEP_ALIVE=30m
POSTGRES_DB=memeindex
POSTGRES_USER=memeindex
POSTGRES_PASSWORD=replace-me

# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=

# Discord OAuth
MEMEINDEX_ALLOW_ANONYMOUS=false
# Maximum total multipart upload request size, including all selected files (256 MiB).
MEMEINDEX_MAX_UPLOAD_BYTES=268435456
MEMEINDEX_DISCORD_CLIENT_ID=123456789012345678
MEMEINDEX_DISCORD_CLIENT_SECRET=replace-me
MEMEINDEX_DISCORD_REDIRECT_URL=http://localhost:8080/auth/callback
MEMEINDEX_DISCORD_DYNAMIC_REDIRECT=false
MEMEINDEX_SESSION_SECRET=replace-with-a-long-random-string
# Optional: set separately so rotating the session secret does not invalidate active share links.
MEMEINDEX_SHARE_SECRET=
MEMEINDEX_SESSION_DURATION_DAYS=30
MEMEINDEX_COOKIE_SECURE=false

# Access control
MEMEINDEX_SUPER_ADMIN_USER_IDS=333333333333333333
MEMEINDEX_VIEW_USER_IDS=111111111111111111,222222222222222222
MEMEINDEX_ADD_USER_IDS=222222222222222222
